# Public LinkedIn profile URL. Until set, the Contact section shows a "replace before launch" placeholder.
VITE_LINKEDIN_URL=

# Optional form backend (e.g. https://formspree.io/f/xxxx). If empty, the form opens a prefilled email draft instead.
VITE_FORM_ENDPOINT=

# Optional production origin, used for absolute Open Graph image URLs, e.g. https://rahulvijayan.dev
VITE_SITE_URL=
